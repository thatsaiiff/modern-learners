# ==============================================================================
# Modern Learners — Saif Classes
# Environment Variables Configuration Template
# ==============================================================================

# PostgreSQL Connection String (Neon Serverless PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example-host.neon.tech/modern_learners?sslmode=require"

# JWT Authentication Secret (Generate with `openssl rand -base64 32`)
# Minimum 32 characters required for HS256 encryption
AUTH_SECRET="replace-with-cryptographically-secure-random-secret-min-32-chars"

# Application Metadata & Base URL
NEXT_PUBLIC_APP_NAME="Modern Learners — Saif Classes"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Node Environment ("development" or "production")
NODE_ENV="production"

# Optional Initial Admin Setup Credentials (used during initial `prisma:seed`)
# ADMIN_EMAIL="admin@modernlearners.com"
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="replace-with-secure-admin-password"
